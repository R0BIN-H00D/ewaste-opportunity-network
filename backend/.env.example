NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ewaste
CLIENT_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Auth (generate long random strings; never commit real values)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
# Seconds in which a just-used refresh token presented again counts as two tabs refreshing together, not theft (0 = off)
REFRESH_GRACE_SECONDS=10
REFRESH_TTL_DAYS=14
BCRYPT_COST=12

# Storage: cloudinary | local (local = dev only)
STORAGE_DRIVER=local
UPLOAD_DIR=              # optional absolute path for local uploads (default backend/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push (empty = push disabled, in-app notifications still work)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Background jobs (pickup reminders): on unless set to false
SCHEDULER_ENABLED=true

# Optional AI (free tier only; empty/false = rule-based fallback)

# Email (empty = emails are logged to console in development, so nobody receives the verification code)
# To send real emails from a Gmail account:
#   1. Turn on 2-Step Verification for that Google account.
#   2. Create an "App password" at https://myaccount.google.com/apppasswords (16 letters).
#   3. Fill in the lines below, using the Gmail address and that app password (not your normal password):
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587
#        SMTP_USER=yourname@gmail.com
#        SMTP_PASS=abcdefghijklmnop
#        MAIL_FROM="E-Waste Network <yourname@gmail.com>"
#   4. Restart the backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E-Waste Network <no-reply@example.com>"
SUPPORT_EMAIL=support@example.com     # contact-form messages are delivered here

# Geocoding (Nominatim public policy: identify your app, <=1 req/s)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=EWasteOpportunityNetwork/0.1
NOMINATIM_CONTACT_EMAIL=

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=3000   (default: 3000 while developing, 300 in production; one address shares it, so the web app, the phone and the tests count together)
AUTH_RATE_LIMIT_MAX=20
CONTACT_RATE_LIMIT_MAX=5

# Seed (dev only)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe!12345

# Demo online payments: Razorpay TEST mode only (free, no KYC, no real money).
# Get keys at https://dashboard.razorpay.com (switch to Test Mode > Account & Settings > API keys). Keys must start with rzp_test_.
# Empty = the "Pay online" option is switched off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Free AI (Google Gemini free tier): device-from-photo and repair/recycle advice.
# Key: https://aistudio.google.com/app/apikey (free, no card). Photos are sent to Google only when someone presses an AI button.
# Off or empty = rule-based answers from the words typed (no photo reading).
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview
GEMINI_DAILY_LIMIT=200
# How patient the AI calls are with the busy free service (these defaults are fine): most tries in all, the most time one call
# may take, the most one try may wait, and how long a good answer is remembered (so the same photos are not sent twice).
GEMINI_ATTEMPTS=10
GEMINI_BUDGET_MS=48000
GEMINI_TRY_TIMEOUT_MS=18000
GEMINI_CACHE_TTL_MS=3600000
